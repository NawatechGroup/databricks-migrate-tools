# Databricks connection
DATABRICKS_HOST=https://adb-2343663971966163.3.azuredatabricks.net/
DATABRICKS_TOKEN=
DATABRICKS_SQL_WAREHOUSE_ID=f3ab3ba7b768bd57

# Comma-separated source catalogs to migrate from
DATABRICKS_CATALOGS=arborvitae-catalog

# Metadata filters
DATABRICKS_SCHEMA_INCLUDE=arborvitae
DATABRICKS_SCHEMA_EXCLUDE=default,information_schema
DATABRICKS_TABLE_EXCLUDE_REGEXP=raw|view|user_social_media_table

# Notebook migration (Databricks notebooks -> Fabric notebooks)
# Root Databricks workspace path to scan for notebooks
DATABRICKS_NOTEBOOK_PATH=/Shared/dwh/serverless/DWH Serverless/Tabel Details/Arborvitae/
# Notebooks whose path contains this substring are skipped
DATABRICKS_EXCLUDE_PATH_CONTAINS=Backup,Test,Stop,stop

# Whether to run preprocess_databricks_source rewrites, or migrate notebooks as-is
MIGRATE_PREPROCESS=true

# Data insert migration (insert_data_migration.py) - requires OneLake shortcuts
# already created for each Databricks Unity Catalog storage location
# INTO or OVERWRITE
DATA_INSERT_MODE=OVERWRITE
INSERT_OUTPUT_PATH=migration_inserts.sql
EXECUTE_DATA_INSERT=true

# Fabric connection
FABRIC_TOKEN=
FABRIC_WORKSPACE_ID=66477a93-0ee0-4aaa-9453-1b2961f65ce1
FABRIC_LAKEHOUSE_ID=8ef2ecb3-de1c-4dd9-85fa-e5a9ad4f7ae6
FABRIC_LAKEHOUSE_NAME=SharedLakehouse
FABRIC_LIVY_API_VERSION=2023-12-01

# Execution behavior
BATCH_SIZE=20
POLL_INTERVAL_SECONDS=1
SESSION_POLL_INTERVAL_SECONDS=3
EXECUTE_SCHEMA_CREATION=true
EXECUTE_TABLE_CREATION=true
VERIFY_SCHEMAS=true
CLOSE_SESSION_ON_FINISH=true

# Optional output file for generated DDL statements
DDL_OUTPUT_PATH=migration_ddls.sql
